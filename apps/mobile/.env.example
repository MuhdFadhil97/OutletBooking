# Copy to apps/mobile/.env  — the ONLY env var the app uses. No secrets here.
# On a real phone (Expo Go) use your laptop's LAN IP, e.g. http://192.168.1.23:3000
# (the API prints it on start-up). For Expo web / emulator on the laptop: http://localhost:3000
EXPO_PUBLIC_API_URL=http://192.168.1.23:3000
