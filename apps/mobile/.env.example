# Copy to apps/mobile/.env  — the ONLY env var the app uses. No secrets here.
# On a real phone (Expo Go) use your laptop's LAN IP, e.g. http://192.168.1.23:3000
# (the API prints it on start-up). For Expo web / emulator on the laptop: http://localhost:3000
EXPO_PUBLIC_API_URL=http://192.168.1.23:3000
# Optional: where the shared booking link points. Dev default = this laptop on port 8081 (Expo web).
# EXPO_PUBLIC_BOOKING_URL=https://outletbooking.my
# Marketing website ("Make your own booking page" on F6). Default https://outletbooking.my
# EXPO_PUBLIC_WEBSITE_URL=http://localhost:3001
# Staging web build (Vercel project "outletbooking-app-staging", root directory apps/mobile) — set these in Vercel:
#   EXPO_PUBLIC_API_URL=https://api.staging.outletbooking.my
#   EXPO_PUBLIC_BOOKING_URL=https://app.staging.outletbooking.my
#   EXPO_PUBLIC_WEBSITE_URL=https://staging.outletbooking.my
