# Copy to apps/mobile/.env  — the ONLY env var the app uses. No secrets here.
# On a real phone in development the app uses the laptop address it loaded from (the one in
# Expo's QR code) automatically, so a changing Wi-Fi / hotspot IP needs no edit here — only the
# port below is used. With --tunnel, or for Expo web / emulator, this URL is used as written
# (e.g. http://localhost:3000).
EXPO_PUBLIC_API_URL=http://192.168.1.23:3000
# Optional: where the shared booking link points. Dev default = this laptop on port 8081 (Expo web).
# EXPO_PUBLIC_BOOKING_URL=https://outletbooking.my
