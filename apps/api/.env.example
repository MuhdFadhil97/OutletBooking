# Copy to apps/api/.env  (never commit .env)

# Local Docker Postgres. Later: Supabase pooler URL (only this line changes).
DATABASE_URL=postgres://outlet:outlet@localhost:5432/outletbooking
# Used by Vitest (database created by docker/postgres-init on first start)
TEST_DATABASE_URL=postgres://outlet:outlet@localhost:5432/outletbooking_test
# Set to false for Supabase Transaction pooler (port 6543)
DB_PREPARE=true

PORT=3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated. App scheme, Expo Go (exp://) and Expo web dev server.
TRUSTED_ORIGINS=outletbooking://,exp://,http://localhost:8081

# Public booking page base URL (domain not registered yet — keep configurable)
APP_PUBLIC_URL=http://localhost:8081

# Email (password reset links).
#  console = print the email (and reset link) in the API log — local dev only, refused in production.
#  resend  = send through Resend (https://resend.com). Needs an API key and a sender on a domain
#            verified in Resend. Before outletbooking.my is verified you can test with
#            MAIL_FROM="OutletBooking <onboarding@resend.dev>" (delivers only to your own Resend login email).
MAIL_TRANSPORT=console
# MAIL_FROM="OutletBooking <no-reply@outletbooking.my>"
# RESEND_API_KEY=re_...
# Push notifications go through Expo's push service; set to off to disable.
# PUSH_TRANSPORT=expo

# ToyyibPay (Phase 5) — sandbox
TOYYIBPAY_BASE_URL=https://dev.toyyibpay.com
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=outletbooking
S3_ACCESS_KEY_ID=outlet
S3_SECRET_ACCESS_KEY=outletminio
