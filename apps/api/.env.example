# Copy to apps/api/.env  (never commit .env)

# Local Docker Postgres. Later: Supabase pooler URL (only this line changes).
DATABASE_URL=postgres://outlet:outlet@localhost:5432/outletbooking
# Used by Vitest (database created by docker/postgres-init on first start)
TEST_DATABASE_URL=postgres://outlet:outlet@localhost:5432/outletbooking_test
# Set to false for Supabase Transaction pooler (port 6543)
DB_PREPARE=true

PORT=3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated. App scheme, Expo Go (exp://) and Expo web dev server.
TRUSTED_ORIGINS=outletbooking://,exp://,http://localhost:8081

# Public booking page base URL (domain not registered yet — keep configurable)
APP_PUBLIC_URL=http://localhost:8081
# Marketing website (E3 opens its plan payment page)
WEBSITE_URL=https://outletbooking.my

# Email (password reset links).
#  console = print the email (and reset link) in the API log — local dev only, refused in production.
#  resend  = send through Resend (https://resend.com). Needs an API key and a sender on a domain
#            verified in Resend. Before outletbooking.my is verified you can test with
#            MAIL_FROM="OutletBooking <onboarding@resend.dev>" (delivers only to your own Resend login email).
MAIL_TRANSPORT=console
# MAIL_FROM="OutletBooking <no-reply@outletbooking.my>"
# RESEND_API_KEY=re_...

# Expo push (optional): access token, only if "Enhanced push security" is enabled for the Expo project
EXPO_ACCESS_TOKEN=

# ToyyibPay — sandbox: https://dev.toyyibpay.com · live: https://toyyibpay.com
# Each business connects its OWN account in the app (Setup → Payments); their key is stored encrypted.
TOYYIBPAY_BASE_URL=https://dev.toyyibpay.com
# Encrypts the businesses' ToyyibPay keys. Generate once and keep it safe:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Public URL ToyyibPay calls back after a payment. Locally: your tunnel URL, e.g.
#   cloudflared tunnel --url http://localhost:3000   → https://xxxx.trycloudflare.com
# Leave empty to use BETTER_AUTH_URL (callbacks then can't reach a laptop, but the app still
# re-checks the bill when the customer returns from ToyyibPay).
API_PUBLIC_URL=
# Platform's own account for plan payments (Phase 7)
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=

# Background jobs (pg-boss): unpaid-booking expiry, staff day summary, trial reminders
JOBS_ENABLED=true

# S3-compatible storage for S2 photos (RustFS via docker compose locally; R2 / Supabase later)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=outletbooking
S3_ACCESS_KEY_ID=outlet
S3_SECRET_ACCESS_KEY=outletminio
# Testing on a phone: signed photo links must use the laptop's LAN IP, e.g. http://192.168.1.20:9000
S3_PUBLIC_URL=
